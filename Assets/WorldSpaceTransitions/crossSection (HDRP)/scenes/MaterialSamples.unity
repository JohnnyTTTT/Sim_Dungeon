  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Brick wall\nThis material uses Tessellation Displacement to bring more
    details to the mesh. Tessellation displacement can modify an object's silhouette
    as it adds vertices and can displace them outwards. \nThe Phong tessellation
    displaces the vertices created by tessellation along the normals of the surface
    in order to smooth the geometry.\nThen the tessellation vertices are displaced
    according to the Height Map and its settings.\nUV seams should use a neutral
    displacement value as they can easily produce cracks in the mesh.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
