    \"m_Title\": \"Normal Blending\",\n    \"m_Content\": \"We use the HeightMask
    to blend between the cobblestones normal map and the flat normal of the gold
    material.\",\n    \"m_TextSize\": 0,\n    \"m_Theme\": 0,\n    \"m_Position\":
    {\n        \"serializedVersion\": \"2\",\n        \"x\": -409.5000305175781,\n       
    \"y\": 394.0000305175781,\n        \"width\": 200.00001525878907,\n        \"height\":
    100.00003051757813\n    },\n    \"m_Group\": {\n        \"m_Id\": \"e7059387ea084d8593d4b4a55fa1934d\"\n   
    }\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.StickyNoteData\",\n   
    \"m_ObjectId\": \"bc4b3ebfeca7492e8fbdd3207075742a\",\n    \"m_Title\": \"Height
    Mask\",\n    \"m_Content\": \"We use U texture coordinate as a smooth gradient
    mask.\\n\\nThe gold material is applied in the lower areas of the cobblestones
    first and then gradually rises until just the tops of the cobblestones show before
    being replaced completely by the gold.\\r\\n\\n\",\n    \"m_TextSize\": 0,\n   
    \"m_Theme\": 0,\n    \"m_Position\": {\n        \"serializedVersion\": \"2\",\n       
    \"x\": -930.0000610351563,\n        \"y\": 214.50001525878907,\n        \"width\":
